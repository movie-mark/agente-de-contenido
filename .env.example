# =============================================================================
# REPOSITORIO PRINCIPAL
# =============================================================================
# Este proyecto está sincronizado con el repositorio remoto de GitHub:
# https://github.com/movie-mark/agente-de-contenido
#
# IMPORTANTE: Este repositorio es la fuente de verdad. Antes de hacer cambios
# importantes, asegúrate de hacer 'git pull' para estar actualizado.
#
# Para sincronizar cambios:
#   - git pull          # Traer cambios del remoto
#   - git push          # Subir cambios locales al remoto
#
# =============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# =============================================================================

# API Key de Anthropic (Claude)
# Obtén tu API key en: https://console.anthropic.com/
CLAUDE_API_KEY=

# Modelo de Claude a usar (opcional, por defecto usa claude-3-5-sonnet-20241022)
# Opciones: claude-3-5-sonnet-20241022, claude-sonnet-4-5, etc.
CLAUDE_MODEL=claude-sonnet-4-5

# URLs de Webhooks para notificaciones (opcionales)
# Cuando un workflow completa exitosamente, enviará un POST con los resultados al webhook correspondiente
WEBHOOK_URL_ORGANIC_CONTENT=
WEBHOOK_URL_BLOG_ARTICLES=
WEBHOOK_URL_GOOGLE_ADS=
WEBHOOK_URL_PAID_SOCIAL_CONTENT=
